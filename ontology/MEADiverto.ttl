@prefix : <http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#> .

<http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#cultivates
:cultivates rdf:type owl:ObjectProperty ;
            owl:inverseOf :isFarmedIn ;
            rdf:type owl:AsymmetricProperty ;
            rdfs:domain :Country ;
            rdfs:range :Fruit .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#hasBeverage
:hasBeverage rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf owl:topObjectProperty ;
             owl:inverseOf :originatesFrom ;
             rdf:type owl:AsymmetricProperty ;
             rdfs:domain :Country ;
             rdfs:range :FermentedAlcoholicBeverage .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#hasIngredient
:hasIngredient rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               owl:inverseOf :isUsedIn ;
               rdf:type owl:AsymmetricProperty ;
               rdfs:domain :FermentedAlcoholicBeverage ;
               rdfs:range :Ingredient .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#isFarmedIn
:isFarmedIn rdf:type owl:ObjectProperty ,
                     owl:AsymmetricProperty ;
            rdfs:domain :Grape ;
            rdfs:range :Country .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#isSimilarTo
:isSimilarTo rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf owl:topObjectProperty ;
             rdf:type owl:SymmetricProperty ,
                      owl:IrreflexiveProperty ;
             rdfs:domain :FermentedAlcoholicBeverage ;
             rdfs:range :FermentedAlcoholicBeverage .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#isUsedIn
:isUsedIn rdf:type owl:ObjectProperty ,
                   owl:AsymmetricProperty ;
          rdfs:domain :Ingredient ;
          rdfs:range :FermentedAlcoholicBeverage .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#originatesFrom
:originatesFrom rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf owl:topObjectProperty ;
                rdf:type owl:AsymmetricProperty ;
                rdfs:domain :FermentedAlcoholicBeverage ;
                rdfs:range :Country .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#colour
:colour rdf:type owl:DatatypeProperty ;
        rdfs:subPropertyOf owl:topDataProperty .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#flavour
:flavour rdf:type owl:DatatypeProperty ;
         rdfs:subPropertyOf owl:topDataProperty .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#maxABV
:maxABV rdf:type owl:DatatypeProperty ;
        rdfs:subPropertyOf owl:topDataProperty .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#minABV
:minABV rdf:type owl:DatatypeProperty ;
        rdfs:subPropertyOf owl:topDataProperty .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#Ale
:Ale rdf:type owl:Class ;
     rdfs:subClassOf :Beer ;
     owl:disjointWith :Lager ;
     rdfs:comment "Ales are beers fermented with top-fermenting yeast at warmer temperatures. They often develop more complex fermentation character and are commonly associated with fuller body and a wide range of historical and modern styles." ;
     rdfs:label "Ale" ;
     rdfs:seeAlso "https://www.wikidata.org/wiki/Q208385" .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#Apple
:Apple rdf:type owl:Class ;
       rdfs:subClassOf :Fruit ;
       owl:disjointWith :Grape ;
       rdfs:comment "A widely cultivated fruit commonly used in fermented beverages such as cider, cyser, fruit wines, and flavored ales." ;
       rdfs:label "Apple" ;
       rdfs:seeAlso "https://www.wikidata.org/wiki/Q89" .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#Beer
:Beer rdf:type owl:Class ;
      rdfs:subClassOf :FermentedAlcoholicBeverage ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :hasIngredient ;
                        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onClass :Malt
                      ] ;
      rdfs:comment """Beer is an alcoholic beverage made by fermenting cereal grains, usually malted barley, with yeast. It may be flavored with hops, herbs, spices, or other ingredients, and is one of the world’s oldest and most widely produced drinks.
Depending on the type of fermentation it can either be an Ale or a Lager.""" ;
      rdfs:label "Beer" ;
      rdfs:seeAlso "https://www.wikidata.org/wiki/Q44" .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#Botanical
:Botanical rdf:type owl:Class ;
           rdfs:subClassOf :Ingredient ;
           owl:disjointWith :SugarSource ;
           rdfs:comment "Herbs, spices and other plants used in beverages to add flavour, enhance mouthfeel and/or improve them." ;
           rdfs:label "Botanical" .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#Cider
:Cider rdf:type owl:Class ;
       rdfs:subClassOf :FermentedAlcoholicBeverage ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasIngredient ;
                         owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onClass :Apple
                       ] ;
       rdfs:comment "Cider is an alcoholic beverage made by fermenting apple juice, though pears and other fruits may also be used in related traditions. It has strong connections to rural agriculture and regional fruit-growing cultures." ;
       rdfs:label "Cider" ;
       rdfs:seeAlso "https://www.wikidata.org/wiki/Q167296" .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#Country
:Country rdf:type owl:Class ;
         rdfs:label "Country" .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#DessertWine
:DessertWine rdf:type owl:Class ;
             rdfs:subClassOf :Wine ;
             rdfs:comment "Dessert wines are wines typically enjoyed with or after a meal. They are often associated with higher residual sugar, fortification, or special aging methods." ;
             rdfs:label "Dessert Wine" ;
             rdfs:seeAlso "https://www.wikidata.org/wiki/Q1200945" .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#FermentedAlcoholicBeverage
:FermentedAlcoholicBeverage rdf:type owl:Class ;
                            rdfs:subClassOf [ rdf:type owl:Restriction ;
                                              owl:onProperty :colour ;
                                              owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange owl:rational
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty :flavour ;
                                              owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange owl:rational
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty :maxABV ;
                                              owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange owl:rational
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty :minABV ;
                                              owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange owl:rational
                                            ] ;
                            rdfs:comment "Class of alcoholic beverages that are created through fermentation or that require fermented beverages to be produced." ;
                            rdfs:label "Fermented Alcoholic Beverage" .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#Fruit
:Fruit rdf:type owl:Class ;
       rdfs:subClassOf :SugarSource ;
       owl:disjointWith :Malt ;
       rdfs:comment "The mature, seed-bearing structure of a flowering plant that develops from the ovary after fertilization, serving primarily to protect and disperse seeds. Used in fermented beverages to produce alcohol from their sugar content." ;
       rdfs:label "Fruit" ;
       rdfs:seeAlso "https://www.wikidata.org/wiki/Q3314483" .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#Grape
:Grape rdf:type owl:Class ;
       rdfs:subClassOf :Fruit ;
       rdfs:comment "One of the oldest cultivated fruits for fermentation, primarily used in winemaking but also in hybrid beverages such as pyment." ;
       rdfs:label "Grape" ;
       rdfs:seeAlso "https://www.wikidata.org/wiki/Q10978" .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#Honey
:Honey rdf:type owl:Class ;
       rdfs:subClassOf :SugarSource ;
       rdfs:label "Honey" ;
       rdfs:seeAlso "https://www.wikidata.org/wiki/Q10987" .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#Hop
:Hop rdf:type owl:Class ;
     rdfs:subClassOf :Botanical ;
     rdfs:comment "Female flower cones (strobiles) of the Humulus lupulus plant, used primarily in brewing for their bitter acids and aromatic oils. The plant is dioecious, with only the female cones being cultivated for commercial use, especially in beer production for flavor, aroma, and preservation." ;
     rdfs:label "Hop" ;
     rdfs:seeAlso "https://www.wikidata.org/wiki/Q104212" .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#Ingredient
:Ingredient rdf:type owl:Class ;
            rdfs:comment "Ingredient class for Fermented Beverages" ;
            rdfs:label "Ingredient" .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#Lager
:Lager rdf:type owl:Class ;
       rdfs:subClassOf :Beer ;
       rdfs:comment "Lagers are beers fermented with bottom-fermenting yeast at cooler temperatures. They are usually conditioned for longer periods, producing a cleaner and more refined fermentation profile." ;
       rdfs:label "Lager" ;
       rdfs:seeAlso "https://www.wikidata.org/wiki/Q253481" .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#Malt
:Malt rdf:type owl:Class ;
      rdfs:subClassOf :SugarSource ;
      rdfs:comment "Malt is grain—typically barley—that has been soaked, allowed to germinate, and then dried to develop enzymes that convert starches into fermentable sugars. It is primarily used in brewing beer and distilling whisky, and also found in malt vinegar, breakfast cereals, and flavored drinks." ;
      rdfs:label "Malt" ;
      rdfs:seeAlso "https://www.wikidata.org/wiki/Q152024" .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#Mead
:Mead rdf:type owl:Class ;
      rdfs:subClassOf :FermentedAlcoholicBeverage ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :hasIngredient ;
                        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onClass :Honey
                      ] ;
      rdfs:comment "Mead is an alcoholic beverage made by fermenting honey with water, sometimes with fruit (Melomels), spices, or grains added (Braggots) It is one of the oldest known fermented drinks and appears in many mythological and historical traditions." ;
      rdfs:label "Mead" ;
      rdfs:seeAlso "https://www.wikidata.org/wiki/Q184442" .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#Melomel
:Melomel rdf:type owl:Class ;
         rdfs:subClassOf :Mead ;
         owl:disjointWith :Metheglin ;
         rdfs:comment "Melomel is mead made with fruit added during fermentation or conditioning. The fruit contributes structure and regional variation to the honey base." ;
         rdfs:label "Melomel" ;
         rdfs:seeAlso "https://www.wikidata.org/wiki/Q16475090" .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#Metheglin
:Metheglin rdf:type owl:Class ;
           rdfs:subClassOf :Mead ;
           rdfs:comment "Metheglin is mead flavored with herbs, spices, or botanicals. The category reflects older medicinal and culinary traditions." ;
           rdfs:label "Metheglin" ;
           rdfs:seeAlso "https://www.wikidata.org/wiki/Q20599140" .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#RedWine
:RedWine rdf:type owl:Class ;
         rdfs:subClassOf :Wine ;
         rdfs:comment "Red wines are made from dark-skinned grapes, with fermentation often involving contact with grape skins. They range widely in structure, aging potential, and regional expression." ;
         rdfs:label "Red Wine" ;
         rdfs:seeAlso "https://www.wikidata.org/wiki/Q1827" .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#Rice
:Rice rdf:type owl:Class ;
      rdfs:subClassOf :SugarSource ;
      rdfs:label "Rice" .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#Sake
:Sake rdf:type owl:Class ;
      rdfs:subClassOf :FermentedAlcoholicBeverage ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :hasIngredient ;
                        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onClass :Rice
                      ] ;
      rdfs:comment "Sake is a Japanese fermented beverage made primarily from polished rice, water, yeast, and koji mold. It occupies a unique place between beer and wine in production method and cultural role." ;
      rdfs:label "Sake" ;
      rdfs:seeAlso "https://www.wikidata.org/wiki/Q170219" .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#SparklingWine
:SparklingWine rdf:type owl:Class ;
               rdfs:subClassOf :Wine ;
               rdfs:comment "Sparkling wines contain carbon dioxide, usually created by a second fermentation. They are often associated with celebrations and formal toasts." ;
               rdfs:label "Sparkling Wine" ;
               rdfs:seeAlso "https://www.wikidata.org/wiki/Q321263" .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#SpicedWine
:SpicedWine rdf:type owl:Class ;
            rdfs:subClassOf :Wine ;
            rdfs:comment "Spiced wines are wines flavored with spices, fruit, herbs, or warming additives. They are often seasonal, festive, or strongly tied to local custom." ;
            rdfs:label "Spiced Wine" .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#SugarSource
:SugarSource rdf:type owl:Class ;
             rdfs:subClassOf :Ingredient ;
             rdfs:comment "Sources of sugar for fermentation of various fermented beverages, sometimes used as ingredients post-fermentation for flavour." ;
             rdfs:label "Sugar Source" .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#WhiteWine
:WhiteWine rdf:type owl:Class ;
           rdfs:subClassOf :Wine ;
           rdfs:comment "White wines are made from white grapes or from grapes fermented without skin contact. They are a broad category covering many styles, from dry to sweet." ;
           rdfs:label "White Wine" ;
           rdfs:seeAlso "https://www.wikidata.org/wiki/Q10210" .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#Wine
:Wine rdf:type owl:Class ;
      rdfs:subClassOf :FermentedAlcoholicBeverage ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :hasIngredient ;
                        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onClass :Grape
                      ] ;
      rdfs:comment "Wine is an alcoholic beverage made by fermenting grape juice, though the term can also be used more broadly for other fruit-based fermentations. It has deep cultural, agricultural, and ceremonial significance across many regions." ;
      rdfs:label "Wine" ;
      rdfs:seeAlso "https://www.wikidata.org/wiki/Q282" .


#################################################################
#    Individuals
#################################################################

###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#Aligote
:Aligote rdf:type owl:NamedIndividual ,
                  :Grape ;
         :isFarmedIn :France ;
         rdfs:comment "A traditional white grape from Burgundy, commonly used for fresh, high-acidity wines and regional table wines." ;
         rdfs:label "Aligoté" ;
         rdfs:seeAlso "https://www.wikidata.org/wiki/Q1514198" .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#Any_Honey
:Any_Honey rdf:type owl:NamedIndividual ,
                    :Honey ;
           rdfs:comment "Honey is a sweet, viscous substance produced by bees from the nectar of flowers or the excretions of other insects, which they refine using enzymes and store in honeycombs as food. It is primarily composed of fructose and glucose, serving as a natural sweetener and having historical uses in cooking, medicine, and preservation." ;
           rdfs:label "Honey" .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#Barley_Wine
:Barley_Wine rdf:type owl:NamedIndividual ,
                      :Ale ;
             :hasIngredient :Caramel_Malt ,
                            :Crystal_Malt ,
                            :East_Kent_Goldings ,
                            :Fuggle ,
                            :Munich_Malt ,
                            :Pale_Malt ;
             :isSimilarTo :Braggot ;
             :originatesFrom :UK ;
             :colour "Amber to deep brown" ;
             :flavour "Rich, malty, caramel, dried fruit" ;
             :maxABV 15 ;
             :minABV 8 ;
             rdfs:comment "A very strong ale traditionally brewed to resemble the strength and prestige of wine. It is often aged and may develop depth through maturation." ;
             rdfs:label "Barley Wine" ;
             rdfs:seeAlso "https://www.wikidata.org/wiki/Q808329" .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#Belgium
:Belgium rdf:type owl:NamedIndividual ,
                  :Country ;
         rdfs:label "Belgium" ;
         rdfs:seeAlso "https://www.wikidata.org/wiki/Q31" .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#Black_Malt
:Black_Malt rdf:type owl:NamedIndividual ,
                     :Malt ;
            rdfs:comment "A heavily roasted malt used primarily for deep color and roasted character in dark beers. It contributes strong roasted grain notes and is typically used in small amounts." ;
            rdfs:label "Black Malt" .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#Blonde_Ale
:Blonde_Ale rdf:type owl:NamedIndividual ,
                     :Ale ;
            :hasIngredient :Cascade ,
                           :Centennial ,
                           :Chinook ,
                           :Pale_Malt ,
                           :Pilsner_Malt ;
            :originatesFrom :UK ;
            :colour "Pale gold" ;
            :flavour "Light, clean, slightly bready, mild fruitiness" ;
            :maxABV 5.5 ;
            :minABV 3.8 ;
            rdfs:comment "A light, approachable ale designed as an easy-drinking style. It is often used as a gateway beer for newer drinkers." ;
            rdfs:label "Blonde Ale" ;
            rdfs:seeAlso "https://www.wikidata.org/wiki/Q23686128" .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#Bochet
:Bochet rdf:type owl:NamedIndividual ,
                 :Mead ;
        :hasIngredient :Caramelised_Honey ;
        :originatesFrom :France ;
        :colour "Amber to dark brown" ;
        :flavour "Caramelized honey, toasted marshmallow, sometimes smoky" ;
        :maxABV 14 ;
        :minABV 10 ;
        rdfs:comment "A mead made with caramelized or heated honey. This technique gives it a distinct historical and craft-oriented identity." ;
        rdfs:label "Bochet" ;
        rdfs:seeAlso "https://www.wikidata.org/wiki/Q22236355" .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#Bock
:Bock rdf:type owl:NamedIndividual ,
               :Lager ;
      :hasIngredient :Hallertau_Mittelfruh ,
                     :Munich_Malt ,
                     :Pilsner_Malt ,
                     :Tettnang ;
      :originatesFrom :Germany ;
      :colour "Amber to dark brown" ;
      :flavour "Malty, toasty, slightly sweet" ;
      :maxABV 7.5 ;
      :minABV 6 ;
      rdfs:comment "A strong lager traditionally associated with German brewing. It is often brewed for seasonal release and historical festive consumption." ;
      rdfs:label "Bock" ;
      rdfs:seeAlso "https://www.wikidata.org/wiki/Q687737" .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#Bordeaux
:Bordeaux rdf:type owl:NamedIndividual ,
                   :RedWine ;
          :hasIngredient :Cabernet_Franc ,
                         :Cabernet_Sauvignon ,
                         :Malbec ,
                         :Merlot ,
                         :Verdot ;
          :originatesFrom :France ;
          :colour "Deep ruby" ;
          :flavour "Structured, tannic, dark fruit, earthy" ;
          :maxABV 15 ;
          :minABV 12 ;
          rdfs:comment "A wine region and style from southwestern France. It is famous for blended red wines and strict regional identity." ;
          rdfs:label "Bordeaux" ;
          rdfs:seeAlso "https://www.wikidata.org/wiki/Q67443910" .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#Braggot
:Braggot rdf:type owl:NamedIndividual ,
                  :Mead ;
         :hasIngredient :Any_Honey ,
                        :Cascade ,
                        :Crystal_Malt ,
                        :East_Kent_Goldings ,
                        :Fuggle ,
                        :Pale_Malt ;
         :colour "Gold to brown" ;
         :flavour "Malt-forward, honey notes, beer-like" ;
         :maxABV 12 ;
         :minABV 6 ;
         rdfs:comment "A hybrid beverage made from both honey and malted grain, combining mead and beer traditions. It has deep historical roots in Northern Europe." ;
         rdfs:label "Braggot" ;
         rdfs:seeAlso "https://www.wikidata.org/wiki/Q113869555" .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#Brown_Ale
:Brown_Ale rdf:type owl:NamedIndividual ,
                    :Ale ;
           :hasIngredient :Chocolate_Malt ,
                          :Crystal_Malt ,
                          :East_Kent_Goldings ,
                          :Fuggle ,
                          :Pale_Malt ;
           :originatesFrom :UK ;
           :colour "Amber to brown" ;
           :flavour "Nutty, caramel, chocolate hints, low bitterness" ;
           :maxABV 7 ;
           :minABV 3.5 ;
           rdfs:comment "A traditional ale style that traces back to older English brewing practices. It is often seen as a balanced, everyday beer with a long regional history" ;
           rdfs:label "Brown Ale" ;
           rdfs:seeAlso "https://www.wikidata.org/wiki/Q2725773" .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#Bual
:Bual rdf:type owl:NamedIndividual ,
               :Grape ;
      :isFarmedIn :Portugal ;
      rdfs:comment "A white grape associated especially with Madeira wine production, known historically as one of the classic Madeira varieties." ;
      rdfs:label "Bual" ;
      rdfs:seeAlso "https://www.wikidata.org/wiki/Q501200" .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#Burgundy
:Burgundy rdf:type owl:NamedIndividual ,
                   :RedWine ;
          :hasIngredient :Aligote ,
                         :Gamay ,
                         :Pinot_Noir ;
          :colour "Light ruby" ;
          :flavour "Red fruit, earthy, light body" ;
          :maxABV 14 ;
          :minABV 12 ;
          rdfs:comment "A historic French wine region known for site-specific winemaking. It is closely associated with terroir-driven wines and traditional appellations." ;
          rdfs:label "Burgundy" ;
          rdfs:seeAlso "https://www.wikidata.org/wiki/Q43771277" .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#Cabernet_Franc
:Cabernet_Franc rdf:type owl:NamedIndividual ,
                         :Grape ;
                :isFarmedIn :France ;
                rdfs:comment "A major red grape from Bordeaux and the Loire Valley, often used in blends but also produced as a varietal wine." ;
                rdfs:label "Cabernet Franc" ;
                rdfs:seeAlso "https://www.wikidata.org/wiki/Q63591" .


###  http://www.semanticweb.org/turco/ontologies/2026/4/MEADiverto#Cabernet_Sauvignon
:Cabernet_Sauvignon rdf:type owl:NamedIndividual ,
                             :Grape ;
                    :isFarmedIn :France ;
